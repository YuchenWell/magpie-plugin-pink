{
  "name": "magpie-plugin-pink",
  "version": "0.1.0",
  "private": true,
  "description": "让 PinK 使用 Magpie 中配置的模型，并查看调用用量与费用",
  "type": "module",
  "main": "./dist/index.mjs",
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "node": ">=22",
    "magpie": ">=0.1.2136"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:magpie": "node scripts/magpie-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build && node scripts/smoke.mjs",
    "status": "node dist/cli.mjs status",
    "restore": "node dist/cli.mjs restore",
    "prepack": "npm run build"
  },
  "magpie": {
    "agent": "./dist/pink.agent.mjs",
    "options": {},
    "icon": "data:image/png;base64,"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
